# syntax=docker/dockerfile:1.7
# Linkspire dashboard (Phase 5, Next.js standalone). Build context: repo root.
FROM node:22-bookworm-slim AS deps
WORKDIR /app
COPY web/package.json web/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci

FROM node:22-bookworm-slim AS build
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
ARG WEB_BUILD_ID=dev
ENV WEB_BUILD_ID=$WEB_BUILD_ID
COPY --from=deps /app/node_modules ./node_modules
COPY web/ ./
RUN npm run build

# Distroless Node runtime; Next standalone server only.
FROM gcr.io/distroless/nodejs22-debian12:nonroot AS run
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
COPY --from=build /app/public ./public
EXPOSE 3000
USER nonroot:nonroot
CMD ["server.js"]

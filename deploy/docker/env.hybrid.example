# Copy to deploy/docker/.env and fill in after tunnels are running.
# PUBLIC_BASE_URL / DEFAULT_DOMAIN_HOST = redirect tunnel (short links).
# Set the same redirect URL in Vercel as NEXT_PUBLIC_SHORT_BASE_URL.

LINKSPIRE_ENV=dev

# Public HTTPS URL for short links (cloudflared / Cloudflare Tunnel → localhost:8080)
PUBLIC_BASE_URL=https://YOUR-REDIRECT-TUNNEL.example.com
DEFAULT_DOMAIN_HOST=YOUR-REDIRECT-TUNNEL.example.com

# Optional: QR encodes this base; defaults to PUBLIC_BASE_URL when empty
# QR_PUBLIC_BASE=https://YOUR-REDIRECT-TUNNEL.example.com

# Use strong random values if the API is exposed to the internet
# TOKEN_SIGNING_KEY=
# FEISTEL_KEY=
# COOKIE_SIGNING_KEY=

# Local dev (npm run dev). On Vercel, set the same keys in Project → Environment Variables.

# Server-side only — must be reachable from Vercel (HTTPS tunnel to laptop :8081)
LINKSPIRE_API_URL=http://localhost:8081

# Public short-link origin (redirect service, not the Vercel app URL)
NEXT_PUBLIC_SHORT_BASE_URL=http://localhost:8080

SESSION_COOKIE_NAME=linkspire_session
SESSION_COOKIE_SECURE=false

# Optional: force no-store on HTML in dev
# LINKSPIRE_NO_CACHE=true
